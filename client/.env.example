# ma3 plugin settings
# Copy this file to .env in the same directory and fill in your values.

# Service URL — defaults to https://hjk41.cc if unset
MA3_BASE_URL=https://hjk41.cc

# Library token for normal read/write operations
MA3_API_KEY=replace_me

# Admin key for library/token management and promote/reject flows (optional)
# MA3_ADMIN_KEY=replace_me

# Authentication mode: x-api-key (default) or bearer
# MA3_AUTH_MODE=x-api-key

# Absolute path to ma3_client.py — set this so Claude can find the script
# without searching the filesystem every session.
# Example (Windows):  MA3_CLIENT_SCRIPT=C:\Users\you\plugins\ma3\client\skills\ma3\scripts\ma3_client.py
# Example (Unix):     MA3_CLIENT_SCRIPT=/home/you/plugins/ma3/client/skills/ma3/scripts/ma3_client.py
# MA3_CLIENT_SCRIPT=
