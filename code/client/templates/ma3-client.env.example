# ma3 client config — copy to ~/.ma3/ma3-client.env and edit for YOUR agent runtime.
# The sync script sources this file; ma3 does not ship per-agent presets.

# --- required ---
MA3_BASE_URL=https://ma3.io

# --- install layout (neutral defaults under ~/.ma3) ---
MA3_CLIENT_CONFIG=${HOME}/.ma3/ma3-client.env
MA3_CLIENT_INSTALL_DIR=${HOME}/.ma3
MA3_CLIENT_STATE=${HOME}/.ma3/ma3-client.json
MA3_BIN_DIR=${HOME}/.ma3/bin
MA3_LIB_DIR=${HOME}/.ma3/lib

# --- where synced bundle files land (relative to MA3_CLIENT_INSTALL_DIR) ---
MA3_ONBOARDING_REL=ma3-agent-onboarding.md
MA3_POLICY_REL=policy/ma3-agent-policy.mdc
MA3_SKILL_REL=skills/ma3/SKILL.md
MA3_MCP_TOOLS_REL=mcp-tools.json

# --- agent-specific: copy policy + skill to YOUR runtime after sync (examples) ---
# Cursor policy:  cp ${MA3_CLIENT_INSTALL_DIR}/${MA3_POLICY_REL} ~/.cursor/rules/ma3-agent-policy.mdc
# Cursor skill:   mkdir -p ~/.cursor/skills/ma3 && cp ${MA3_CLIENT_INSTALL_DIR}/${MA3_SKILL_REL} ~/.cursor/skills/ma3/SKILL.md
# Claude policy:  append/copy into ~/.claude/CLAUDE.md
# Claude skill:   mkdir -p ~/.claude/skills/ma3 && cp ${MA3_CLIENT_INSTALL_DIR}/${MA3_SKILL_REL} ~/.claude/skills/ma3/SKILL.md
# Codex policy:   append/copy into ~/.codex/AGENTS.md
# Codex skill:    mkdir -p ~/.codex/skills/ma3 && cp ${MA3_CLIENT_INSTALL_DIR}/${MA3_SKILL_REL} ~/.codex/skills/ma3/SKILL.md
# Droid:          append policy to ~/.factory/AGENTS.md
# MA3_POLICY_INSTALL_NOTE=Fill in the command your runtime needs after each sync.
# MA3_SKILL_INSTALL_NOTE=Fill in the skill copy command for your runtime after each sync.

# --- MCP reload hint (informational; sync prints mcp_reload_required) ---
# MA3_MCP_RELOAD_NOTE=Cursor: Settings -> Tools & MCP -> Refresh ma3
