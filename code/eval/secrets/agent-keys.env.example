# Per-agent ma3 MCP API keys (ma3v4_*). Generated by bootstrap_eval_tenant.sh.
# Copy to agent-keys.env — never commit.
#
# For Cursor IDE: export MA3_API_KEY=$MA3_KEY_CURSOR_CLI (see .cursor/README.md)

MA3_KEY_CLAUDE_CODE=ma3v4_replace_me
MA3_KEY_DROID=ma3v4_replace_me
MA3_KEY_CURSOR_CLI=ma3v4_replace_me

# Eval library id (filled by bootstrap)
MA3_EVAL_ORG_ID=
MA3_EVAL_LIBRARY_ID=
