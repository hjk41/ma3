# Copy to secrets.env and fill in. Never commit secrets.env.
#
# cp eval/secrets/secrets.env.example eval/secrets/secrets.env
# chmod 600 eval/secrets/secrets.env

# DeepSeek BYOK (Claude Code / Droid / Cursor proxy)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Mihomo / Clash subscription (used by mihomo-proxy & transparent-gateway scenarios)
MIHOMO_SUBSCRIPTION_URL=https://example.com/sub/your-token

# Optional: ma3 base URL for bootstrap scripts
MA3_BASE_URL=http://127.0.0.1:8000

# Optional: Factory Droid platform auth (BYOK still uses DeepSeek for inference)
FACTORY_API_KEY=

# Optional: Cursor CLI cloud auth (without this, eval uses claude+deepseek fallback for cursor-cli slots)
CURSOR_API_KEY=
