FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work/code/server

COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server/app ./app
COPY client ../client

ENV PYTHONPATH=/work/code/server
ENV MA3_DEV_AUTH=1
ENV MA3_DEV_API_KEY=ma3dev
ENV MA3_DISABLE_EMBEDDINGS=1
ENV MA3_DATABASE_URL=sqlite:////data/ma3.db

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
