# ===========================================================================
# ma3 deploy config TEMPLATE  —  deploy/deploy.env.sample
#
# Copy this to a LOCAL, git-ignored file (e.g. deploy/deploy.202.env or
# deploy/deploy.ma3.io.env) and fill in the real values, then run:
#
#   ./deploy/deploy.sh deploy/deploy.202.env
#   ./deploy/deploy.sh deploy/deploy.ma3.io.env
#
# Real per-environment configs are NEVER committed (see deploy/.gitignore).
# Two examples are shown below; keep ONE profile per file.
# ===========================================================================

# ---- common (both profiles) -----------------------------------------------
DEPLOY_PROFILE=example          # informational label
REMOTE_HOST=CHANGE_ME           # target host/IP
REMOTE_USER=CHANGE_ME           # ssh user
REMOTE_DIR=/CHANGE/ME           # remote checkout/run dir
ALLOWED_HOSTS="CHANGE_ME"       # space-separated allowlist; REMOTE_HOST must match (guard)
ENV_MODE=preserve               # 'preserve' (prod) | 'regenerate' (lan/dev)
MA3_PORT=8000
# SSH_KEY=$HOME/.ssh/id_rsa
# Optional arguments appended to both ssh and rsync's remote shell. Example for
# a direct path that must bypass ~/.ssh/config and use a compact KEX proposal:
# SSH_EXTRA_OPTS='-o ProxyCommand=none -o KexAlgorithms=ecdh-sha2-nistp256 -o HostKeyAlgorithms=ssh-ed25519 -o Ciphers=aes128-ctr -o MACs=hmac-sha2-256'
# UVICORN_HOST=0.0.0.0          # 0.0.0.0 for direct LAN; 127.0.0.1 when behind Caddy/nginx
# HEALTHZ_TIMEOUT=240
# REQUIRE_VECTOR=1              # require 'vector' in healthz features before OK
# RUN_VERIFY=1

# ---- preserve mode (production, e.g. ma3.io) -------------------------------
# The remote ma3.env is the source of truth and is left untouched except for
# MA3_GIT_COMMIT injection. These are ASSERTED before the service restarts.
# EXPECT_INSTANCE_ID=ma3-v1-hk
# EXPECT_PUBLIC_BASE_URL=https://ma3.io
# ASSERT_DEV_AUTH_OFF=1         # abort if MA3_DEV_AUTH=1 on the remote
# ASSERT_NO_LAN_PROXY=1         # abort if HTTP(S)_PROXY present (breaks Authing off-LAN)
# VERIFY_API_KEY=               # optional prod API key → unlocks authed MCP pytest in verify_ma3_prod.sh
# MA3_EXPECT_FEATURES=postgresql,vector,oidc
#
# Optional Caddy blue-green (zero-downtime cutover; preserve mode only).
# One-time host setup: import deploy/caddy/upstream.caddy.example from the
# site block (see deploy/caddy/Caddyfile.ma3.io.example), then enable:
# BLUE_GREEN=1
# UVICORN_HOST=127.0.0.1
# BLUE_GREEN_PORT_A=8000
# BLUE_GREEN_PORT_B=8001
# BLUE_GREEN_DRAIN_SEC=5
# CADDY_UPSTREAM_FILE=/opt/ma3_deploy/data/bluegreen/upstream.caddy
# CADDY_RELOAD_CMD='caddy reload --config /etc/caddy/Caddyfile'
# BLUE_GREEN_PUBLIC_SMOKE_URL=https://ma3.io   # defaults to EXPECT_PUBLIC_BASE_URL

# ---- regenerate mode (LAN/dev) ----------------------------------------------
# The remote ma3.env is rebuilt from LEGACY_ENV_FILE + the values below.
# LEGACY_ENV_FILE=/home/youruser/ma3/ma3.env   # remote path sourced for DB/Authing/secrets
# WRITE_INSTANCE_ID=ma3-v1-lan
# WRITE_PUBLIC_BASE_URL=http://192.168.1.100:8000
# DEV_AUTH=0                    # 1 enables the ma3dev break-glass key (LAN only)
# HF_CACHE_SOURCE=/home/youruser/ma3/data/hf-cache
# RUN_MIGRATION=1               # backfill legacy_records into v1 schema
# EXPECT_ROOT_REDIRECT=/ui/me/  # ma3.io landing uses /ui/home/
# VERIFY_API_KEY=ma3dev         # key used by common/verify_ma3.sh pytest gate

# ===========================================================================
# EXAMPLE A — LAN staging (regenerate); use your own LAN host IP
# ---------------------------------------------------------------------------
#   DEPLOY_PROFILE=lan
#   REMOTE_HOST=192.168.1.100
#   REMOTE_USER=youruser
#   REMOTE_DIR=/home/youruser/ma3_deploy
#   ALLOWED_HOSTS="192.168.1.100"
#   ENV_MODE=regenerate
#   UVICORN_HOST=0.0.0.0
#   LEGACY_ENV_FILE=/home/youruser/ma3/ma3.env
#   WRITE_INSTANCE_ID=ma3-v1-lan
#   WRITE_PUBLIC_BASE_URL=http://192.168.1.100:8000
#   DEV_AUTH=0
#   HF_CACHE_SOURCE=/home/youruser/ma3/data/hf-cache
#   RUN_MIGRATION=1
#   VERIFY_API_KEY=ma3dev
#
# EXAMPLE B — production SaaS (preserve); use your server's public IP/domain
# ---------------------------------------------------------------------------
#   DEPLOY_PROFILE=prod
#   REMOTE_HOST=203.0.113.10
#   REMOTE_USER=root
#   REMOTE_DIR=/opt/ma3_deploy
#   ALLOWED_HOSTS="203.0.113.10 ma3.example.com"
#   ENV_MODE=preserve
#   UVICORN_HOST=127.0.0.1
#   EXPECT_INSTANCE_ID=ma3-v1-hk
#   EXPECT_PUBLIC_BASE_URL=https://ma3.io
#   ASSERT_DEV_AUTH_OFF=1
#   ASSERT_NO_LAN_PROXY=1
#   BLUE_GREEN=1
#   BLUE_GREEN_PORT_A=8000
#   BLUE_GREEN_PORT_B=8001
#   CADDY_UPSTREAM_FILE=/opt/ma3_deploy/data/bluegreen/upstream.caddy
#   CADDY_RELOAD_CMD='caddy reload --config /etc/caddy/Caddyfile'
#   # VERIFY_API_KEY=ma3k_...   # optional; enables authed MCP checks in verify_ma3_prod.sh
# ===========================================================================
