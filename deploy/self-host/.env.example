# Copy to .env and edit. Never commit real secrets.

# --- required secrets ---
POSTGRES_PASSWORD=change-me-db-password
MA3_API_KEY_ENCRYPTION_SECRET=change-me-long-random-string

# --- instance ---
MA3_INSTANCE_ID=ma3-selfhost
MA3_PUBLIC_BASE_URL=http://127.0.0.1:8000
MA3_PORT=8000

# Embeddings default ON. First start downloads the model into the data volume.
# MA3_DISABLE_EMBEDDINGS=1
# If the container cannot reach huggingface.co (common on Docker without WAN/IPv6):
# HTTP_PROXY=http://192.168.31.200:1080
# HTTPS_PROXY=http://192.168.31.200:1080
# NO_PROXY=db,localhost,127.0.0.1

# Bootstrap API key when OIDC is not configured (default on).
MA3_BOOTSTRAP_SELFHOST=1
# Written inside the ma3 container data volume; also bind-mounted via compose volume.

# --- optional OIDC (portal login). Prefer MA3_OIDC_*. ---
# MA3_OIDC_ENABLED=1
# MA3_OIDC_ISSUER=https://your-idp.example.com/realms/ma3
# MA3_OIDC_CLIENT_ID=
# MA3_OIDC_CLIENT_SECRET=
# MA3_OIDC_REDIRECT_URI=https://ma3.example.com/auth/callback
# MA3_AUTH_ADMIN_USERS=admin@example.com
# For Authing specifically you may keep legacy vars, or set:
# MA3_OIDC_AUTHING_PATH_COMPAT=1
# MA3_OIDC_ISSUER=https://your-app.authing.cn

# Legacy Authing aliases (still supported):
# MA3_AUTHING_ENABLED=1
# MA3_AUTHING_ISSUER=https://your-app.authing.cn
# MA3_AUTHING_APP_ID=
# MA3_AUTHING_APP_SECRET=
# MA3_AUTH_ADMIN_USERS=admin@example.com

# Never enable on a public URL:
MA3_DEV_AUTH=0
