# Example probe env for Windows off-host monitoring (copy to %USERPROFILE%\.ma3\probe\probe.env)
MA3_BASE_URL=https://ma3.io
MA3_EXPECT_INSTANCE_ID=ma3-v1-hk
MA3_EXPECT_PUBLIC_BASE_URL=https://ma3.io
MA3_PROBE_FAIL_THRESHOLD=3
MA3_PROBE_WEBHOOK_URL=http://127.0.0.1:8787/
# Windows state dir (Linux default is /var/tmp/ma3-probe if unset)
MA3_PROBE_STATE_DIR=C:\Users\YOUR_USER\.ma3\probe\state
MA3_PROBE_DOCTOR=0
# MA3_API_KEY=ma3k_...
